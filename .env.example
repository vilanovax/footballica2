# PostgreSQL connection string for Prisma
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/footballica?schema=public"

# Signs the httpOnly auth session cookie (use a long random string in prod)
AUTH_SECRET="change-me-to-a-long-random-string"

# Protects /api/cron/duels (Vercel Cron sends Authorization: Bearer …)
CRON_SECRET="change-me-cron-secret"
