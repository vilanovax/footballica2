# ─── Required ────────────────────────────────────────────────────────────────

# PostgreSQL connection string for Prisma
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/footballica?schema=public"

# Signs the httpOnly auth session cookie (long random string; REQUIRED in production)
AUTH_SECRET="change-me-to-a-long-random-string"

# Unlocks /admin via ?secret=… (REQUIRED on Vercel — no default there)
# Local next start / next dev: falls back to "footballica-admin" if unset
ADMIN_SECRET="change-me-admin-secret"

# Protects /api/cron/* — Vercel Cron sends Authorization: Bearer <CRON_SECRET>
# Routes: /api/cron/duels (every minute), /api/cron/mystery + /api/cron/grid (daily ~Tehran midnight)
CRON_SECRET="change-me-cron-secret"

# Optional: force fail-closed secrets even on local next start
# FORCE_STRICT_SECRETS=1

# Local only — force IMAGE / CAREER_PATH / REVEAL_IMAGE / HIGHER_LOWER / ALL
# mocks into match draws for format UI polish (ignored on Vercel deploy).
# Or use the in-match "Dev format" chip (sets ff_format cookie).
# NEXT_PUBLIC_FORCE_FORMAT=CAREER_PATH

# ─── Deploy notes (Vercel) ───────────────────────────────────────────────────
# 1. Set DATABASE_URL, AUTH_SECRET, CRON_SECRET, ADMIN_SECRET in Project → Settings → Environment Variables
# 2. Build Command: npm run vercel-build   (runs migrate deploy, then next build)
# 3. Crons in vercel.json → duels every minute; mystery 20:30 UTC + grid 20:35 UTC (~Tehran midnight)
# 4. After first deploy, open /admin?secret=<ADMIN_SECRET> once to mint the admin cookie
# 5. Local migrate: npm run db:migrate:dev -- --name <migration_name>
# 6. Apply pending migrations only: npm run db:deploy
# 7. Local admin unlock: http://localhost:3000/admin?secret=footballica-admin
#    (or whatever ADMIN_SECRET is in your .env)
