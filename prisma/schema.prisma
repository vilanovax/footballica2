// Footballica MVP — PostgreSQL schema (Prisma)
// Source of truth for entities in PRD §7. Scalable for post-MVP (PvP, boosters, live events)
// without overbuilding Phase 1 tables.

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // Connection URL now lives in prisma.config.ts (Prisma v7).
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum ManagerAvatar {
  TACTICAL_COACH
  YOUNG_DIRECTOR
  VETERAN_FAN
  // Unlockable cosmetics — granted by achievements (see lib/game/achievements.ts).
  GOALKEEPER_LEGEND
  SUPER_FAN
  CLUB_LEGEND
  OLD_GAFFER
  STAR_MANAGER
  COSMIC_COACH
}

enum MatchMode {
  TUTORIAL
  QUICK_MATCH
  PENALTY
  /// Endless 3-lives category run (Survival Mode).
  SURVIVAL
}

enum MatchStatus {
  COMPLETED
  ABANDONED
}

enum QuestionDifficulty {
  EASY
  MEDIUM
  HARD
}

/// How a question is presented / answered inside existing Game Modes.
/// New visual puzzles extend this enum — they do NOT invent a new MatchMode.
/// See docs/adr/001-game-mode-vs-format-and-daily-mystery.md
enum QuestionType {
  TEXT
  IMAGE
  /// Club logos / names in career order → identify the player.
  CAREER_PATH
  /// Compare two entities on a hidden metric (higher / lower).
  HIGHER_LOWER
  /// Image starts obscured and reveals in stages; earlier guess = more points.
  REVEAL_IMAGE
}

/// Lifecycle of a club's attempt at today's Mysterious Player puzzle.
enum DailyMysteryAttemptStatus {
  IN_PROGRESS
  SOLVED
  FAILED
}

/// Football Grid daily attempt (ADR 002) — same terminal states as Mystery.
enum DailyGridAttemptStatus {
  IN_PROGRESS
  SOLVED
  FAILED
}

/// Star Path (مسیر ستاره) daily attempt — sequential club-clue puzzle.
enum DailyStarPathAttemptStatus {
  IN_PROGRESS
  SOLVED
  FAILED
}

/// Memory GotD daily attempt — flip pairs against the clock.
enum DailyMemoryAttemptStatus {
  IN_PROGRESS
  SOLVED
  FAILED
}

enum QuestionStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  RETIRED
}

enum ReportStatus {
  PENDING
  RESOLVED
  REJECTED
}

enum BoosterType {
  COIN_BOOST
  FAN_BOOST
}

/// Async Draft Duel lifecycle (2 light rounds: each player attacks once + defends once).
enum DuelStatus {
  /// Looking for a human opponent (or about to assign a bot).
  MATCHING
  /// Challenger (A) is drafting a category and/or answering their attack.
  A_ATTACKING
  /// A finished attack; waiting for opponent B.
  WAITING_B
  /// B is answering A's questions (defense).
  B_DEFENDING
  /// B is drafting + answering their own attack.
  B_ATTACKING
  /// B finished attack; waiting for A to defend.
  WAITING_A
  /// A is answering B's questions (defense).
  A_DEFENDING
  COMPLETED
  EXPIRED
  FORFEIT
}

/// Skill band for PvP cold-start bots (drives answer accuracy).
enum BotDifficulty {
  EASY
  MEDIUM
  HARD
}

/// Per-round format inside a Draft Duel (one special format max per match).
enum DuelRoundType {
  QUIZ
  MEMORY
  MYSTERY
  GRID
  STAR_PATH
  /// Shared PvP tic-tac-toe on Immortal-style axes (Tiki-Taka).
  TIKI_TAKA
}

/// Campaign = long-running LiveOps ladder. Daily = Tehran calendar day reset.
enum MissionBatchKind {
  CAMPAIGN
  DAILY
}

/// LiveOps mission objective — evaluated from match stats in missionEngine.
enum MissionObjective {
  /// Correct answers ("goals") accumulated across matches.
  SCORE_GOALS
  /// Completed non-tutorial matches.
  PLAY_MATCHES
  /// Wins (goal majority) on non-tutorial matches.
  WIN_MATCHES
  /// Best combo in a match must reach `targetValue` (progress = max combo seen).
  PERFECT_COMBO
  /// Finished a Draft Duel (win or lose).
  PLAY_DUEL
  /// Won a Draft Duel (includes walkover / expire wins).
  WIN_DUEL
}

/// Business-layer facilities (ADR 003) — Club Funds only, not match coins.
enum BusinessFacilityKey {
  TICKET_OFFICE
  CLUB_SHOP
  MUSEUM
}

enum ClubFacilityStatus {
  LOCKED
  AVAILABLE
  BUILT
}

// ─── User (Manager) ──────────────────────────────────────────────────────────
// Owns auth identity + global progression. Economy currency lives on Club.

model User {
  id            String         @id @default(cuid())
  /// Iranian mobile (`09xxxxxxxxx`). Null for bots (they never OTP-login).
  phone         String?        @unique
  /// Optional legacy/dev email (system bot + mock leaderboard rows).
  email         String?        @unique
  displayName   String?
  managerAvatar ManagerAvatar?
  xp            Int            @default(0)
  managerLevel  Int            @default(1)
  /// XP earned in the current weekly window (leaderboard). Reset via cron/job.
  weeklyXp      Int            @default(0)

  /// Cold-start PvP opponent pool (Admin-generated). Shares User + Club models.
  isBot         Boolean        @default(false)
  botDifficulty BotDifficulty?
  /// Admin kill-switch — disabled bots stay in CMS but are skipped by matchmaking.
  botEnabled    Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  club       Club?
  matches    Match[]
  hallOfFame HallOfFame[]

  duelsAsChallenger DuelMatch[] @relation("DuelChallenger")
  duelsAsOpponent   DuelMatch[] @relation("DuelOpponent")

  @@index([weeklyXp])
  @@index([xp])
  @@index([isBot, botEnabled, botDifficulty])
}

/// Archived weekly league podium (top 3 humans) snapshot before `weeklyXp` reset.
model HallOfFame {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Tehran ISO-like week that just ended (`YYYY-Www`).
  tehranWeekKey String
  /// Podium place: 1, 2, or 3.
  rank          Int
  /// `weeklyXp` at archive time (before reset to 0).
  xp            Int
  createdAt     DateTime @default(now())

  @@unique([tehranWeekKey, rank])
  @@unique([tehranWeekKey, userId])
  @@index([tehranWeekKey, rank])
  @@index([userId])
}

// ─── Club (Metagame hub) ─────────────────────────────────────────────────────
// 1:1 with User in MVP. Drop @unique on userId later if multi-club is needed.
// Upgrade levels drive visuals, stamina caps, and reward multipliers in app logic.

model Club {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name           String
  /// Lowercased / collapsed form of `name` for unique case-insensitive checks.
  nameNormalized String  @unique
  /// Player-chosen stadium name (identity/profile). Falls back to a default.
  stadiumName    String?
  /// Chosen manager avatar key (see lib/onboarding/avatars), set during onboarding.
  avatar         String?
  /// Chosen club flag key (see lib/onboarding/flags). Cosmetic identity; premium
  /// flags are level-gated (re-checked server-side in setClubFlag).
  flag           String?
  /// Club kit / brand palette key (see lib/onboarding/clubColors). Scoped accents only.
  colorKey       String  @default("CLUB_GREEN")
  /// FTUE progress: 0 = play tutorial match, 1 = buy first upgrade, 2 = done.
  tutorialStep   Int     @default(0)

  // Economy balances (server-authoritative)
  coins             Int       @default(0)
  fans              Int       @default(0)
  stamina           Int       @default(3)
  maxStamina        Int       @default(3)
  /// Anchor for passive stamina regeneration (recomputed on read).
  lastStaminaUpdate DateTime  @default(now())
  /// Last time the daily Newspaper booster was claimed (null = never). Gates
  /// the "once per day" claim; a fresh calendar day re-enables the mailbox.
  lastNewsClaim     DateTime?

  // ── Business layer / Club Funds (ADR 003) — separate from match coins ──
  /// Spendable Club Funds (build / upgrade business facilities + vault).
  clubFunds    Int @default(0)
  /// Funds sitting in the vault after collect (capped by vaultLevel).
  vaultBalance Int @default(0)
  /// Vault capacity tier (hours of aggregate income). Starts at 1.
  vaultLevel   Int @default(1)
  /// Temporary income multiplier end (first win of Tehran day).
  businessBoostExpiresAt DateTime?
  /// When the daily business boost was last granted (Tehran day gate).
  lastBusinessBoostAt    DateTime?
  /// Opt-in sponsored bank — lazy % interest on spendable Club Funds.
  sponsoredBankActive Boolean   @default(false)
  /// Anchor for sponsored-bank interest ticks (advanced on settle).
  lastBankInterestAt  DateTime?

  // Infrastructure upgrade levels (0 = ruined start state)
  stadiumLevel        Int @default(0)
  pitchLevel          Int @default(0)
  medicalLevel        Int @default(0)
  /// Training Ground raises daily match capacity / maxStamina (PRD stamina system)
  trainingGroundLevel Int @default(0)

  // Consumable booster inventory (bought from the Shop, spent in a match)
  /// 50/50 boosters: removes two wrong options for one kick.
  boosterFiftyFifty  Int @default(0)
  /// Freeze boosters: pauses the fuse timer once per match.
  boosterFreezeTimer Int @default(0)

  // ── Profile stats (denormalized for cheap reads + achievement checks) ──
  /// Lifetime completed matches (excludes the FTUE tutorial).
  matchesPlayed Int @default(0)
  /// Lifetime wins (goal majority).
  matchesWon    Int @default(0)
  /// Lifetime correct answers ("goals" scored).
  goalsTotal    Int @default(0)
  /// Best consecutive-correct streak ever achieved in a single match.
  highestCombo  Int @default(0)

  // ── Daily play streak (Duolingo-style retention loop, Asia/Tehran days) ──
  dailyStreak        Int       @default(0)
  longestDailyStreak Int       @default(0)
  /// Day-anchor (midnight Asia/Tehran) of the last match that advanced the streak.
  lastPlayedDate     DateTime?

  // ── Mysterious Player daily streak (isolated from match dailyStreak) ──
  /// Consecutive Tehran days with a SOLVED DailyMysteryAttempt.
  mysteryStreak        Int       @default(0)
  longestMysteryStreak Int       @default(0)
  /// Lifetime SOLVED mystery days (drives debut / volume mystery badges).
  mysterySolves        Int       @default(0)
  /// Day-anchor of the last mystery solve that advanced mysteryStreak.
  lastMysteryDate      DateTime?

  // ── Football Grid daily streak (ADR 002 — isolated from mystery streak) ──
  gridStreak        Int       @default(0)
  longestGridStreak Int       @default(0)
  gridSolves        Int       @default(0)
  lastGridDate      DateTime?

  // ── Star Path daily streak (GotD #3 — isolated) ──
  starPathStreak        Int       @default(0)
  longestStarPathStreak Int       @default(0)
  starPathSolves        Int       @default(0)
  lastStarPathDate      DateTime?

  // ── Memory GotD daily streak (isolated) ──
  memoryStreak        Int       @default(0)
  longestMemoryStreak Int       @default(0)
  memorySolves        Int       @default(0)
  lastMemoryDate      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matches          Match[]
  boosters         ActiveBooster[]
  badges           ClubBadge[]
  missionBatches   ClubMissionBatch[]
  missions         ClubMission[]
  purchases        PurchaseLog[]
  adminGrants      AdminCoinGrant[]
  categoryRecords  CategoryRecord[]
  challengeAccess  ClubChallengeAccess[]
  challengeRuns    ClubChallengeRun[]
  mysteryAttempts  DailyMysteryAttempt[]
  gridAttempts     DailyGridAttempt[]
  starPathAttempts DailyStarPathAttempt[]
  memoryAttempts   DailyMemoryAttempt[]
  facilities       ClubFacility[]

  @@index([fans])
  @@index([coins])
}

/// Per-club business facility state (lazy income — ADR 003).
model ClubFacility {
  id     String @id @default(cuid())
  clubId String
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  key              BusinessFacilityKey
  status           ClubFacilityStatus @default(LOCKED)
  /// 0 until built; built facilities start at 1.
  level            Int                @default(0)
  storedAmount     Int                @default(0)
  lastCalculatedAt DateTime           @default(now())
  /// Optimistic lock for collect / upgrade double-taps.
  version          Int                @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clubId, key])
  @@index([clubId, status])
}

/// Immutable IAP ledger for mock (and future real) coin-pack purchases.
/// Soft-currency sinks (stamina refill, boosters, upgrades) are NOT logged here.
model PurchaseLog {
  id           String   @id @default(cuid())
  clubId       String
  club         Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  /// Server catalog tier key (`SMALL` | `MEDIUM` | `LARGE`).
  packTier     String
  /// Fiat amount charged (mock gateway display units).
  price        Int
  currency     String
  coinsGranted Int
  /// PENDING | SUCCESS | FAILED
  status       String
  createdAt    DateTime @default(now())

  @@index([clubId, createdAt])
  @@index([status])
}

/// Admin CMS coin top-ups (manual grants). Separate from IAP PurchaseLog.
model AdminCoinGrant {
  id        String   @id @default(cuid())
  clubId    String
  club      Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  /// Positive coin delta applied to the club.
  amount    Int
  /// Optional operator note (support ticket, promo, etc.).
  reason    String?
  createdAt DateTime @default(now())

  @@index([clubId, createdAt])
}

// ─── BadgeDefinition (admin-editable badge presentation) ─────────────────────
// Unlock rules stay in `lib/game/achievements.ts` (system) or RecordChallenge
// (showcase). This table owns Live-Ops copy + art: title, description, emoji,
// image URL, and reward amounts. Seeded from the code catalog on first admin load.

model BadgeDefinition {
  id            String   @id @default(cuid())
  /// Stable key — matches Achievement.slug or challenge rewardBadgeSlug.
  slug          String   @unique
  nameEn        String
  nameFa        String
  descriptionEn String
  descriptionFa String
  emoji         String   @default("🏅")
  /// Optional art URL (`/badges/...` or absolute). When set, UI prefers image over emoji.
  imageUrl      String?
  rewardCoins   Int      @default(0)
  rewardXp      Int      @default(0)
  /// skill | purity | dedication | volume | showcase
  category      String   @default("skill")
  /// bronze | silver | gold
  tier          String   @default("bronze")
  /// True when seeded from the code achievement catalog.
  isSystem      Boolean  @default(true)
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@index([category])
}

// ─── ClubBadge (unlocked achievements) ───────────────────────────────────────
// Join row: which club unlocked which badge. Presentation comes from
// BadgeDefinition (fallback: code catalog). Reward granted at unlock is
// snapshotted for an audit trail. One row per (club, badge).

model ClubBadge {
  id     String @id @default(cuid())
  clubId String
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  /// Stable slug into the code-defined achievement catalog OR a premium challenge badge.
  badgeSlug    String
  /// Small reward paid out when the badge was unlocked (audit snapshot).
  coinsAwarded Int    @default(0)
  xpAwarded    Int    @default(0)

  /// When set, this showcase badge was earned by conquering a RecordChallenge.
  sourceChallengeId String?
  sourceChallenge   RecordChallenge? @relation(fields: [sourceChallengeId], references: [id], onDelete: SetNull)

  unlockedAt DateTime @default(now())

  @@unique([clubId, badgeSlug])
  @@index([clubId])
  @@index([sourceChallengeId])
}

// ─── ActiveBooster (Newspaper Events) ────────────────────────────────────────
// Temporary reward multipliers granted by "newspaper" popups (PRD §4D).
// A booster is valid while expiresAt > now(). Expired rows can be pruned lazily.

model ActiveBooster {
  id     String @id @default(cuid())
  clubId String
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  type       BoosterType
  multiplier Float       @default(2.0)
  /// Headline shown in the newspaper that granted it (for re-display).
  headline   String

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([clubId, expiresAt])
}

// ─── Match (MatchHistory) ────────────────────────────────────────────────────
// Append-only reward ledger. Client never mutates Club economy without a Match row.

model Match {
  id     String @id @default(cuid())
  userId String
  clubId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  mode   MatchMode
  status MatchStatus @default(COMPLETED)

  /// Survival (and future solo) category lock. Null for mixed-bank Penalty/Quick.
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// Optional Premium RecordChallenge this Survival run was played under.
  recordChallengeId String?
  recordChallenge   RecordChallenge? @relation(fields: [recordChallengeId], references: [id], onDelete: SetNull)

  // Football-framed scoreline (Correct = goal for, Wrong = conceded / miss)
  goalsFor       Int @default(0)
  goalsAgainst   Int @default(0)
  questionsTotal Int
  correctCount   Int @default(0)

  // Reward snapshot applied to Club/User at finish (anti-cheat audit trail)
  coinsEarned  Int @default(0)
  xpEarned     Int @default(0)
  fansEarned   Int @default(0)
  staminaSpent Int @default(1)

  /// Longest consecutive-correct streak in this match (drives combo badges).
  bestCombo Int     @default(0)
  /// Whether any help was used (50/50, freeze, or superpower) — gates "no help" badges.
  usedHelp  Boolean @default(false)

  /// Optional JSON audit: question ids answered, correctness, timings
  answerLog Json?

  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, finishedAt])
  @@index([clubId, finishedAt])
  @@index([mode, finishedAt])
  @@index([categoryId, finishedAt])
  @@index([recordChallengeId, finishedAt])
}

// ─── GameConfig (Live-Ops economy tuning) ────────────────────────────────────
// Single-row (singleton, id = "global") key store for all balancing numbers —
// Match rewards, Survival soft economy, Duel, helpers, match size.
// Editable from Admin → Economy (`/admin/config`) without a deploy.
// Shape mirrors `GameConfig` in lib/game/economy.ts; unknown/missing keys
// fall back to DEFAULT_GAME_CONFIG via mergeGameConfig.

model GameConfig {
  id        String   @id @default("global")
  config    Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Category (question grouping) ────────────────────────────────────────────
// Bilingual, admin-managed buckets (World Cup, Iran Pro League, Nostalgia, …).

model Category {
  id            String   @id @default(cuid())
  slug          String   @unique
  nameEn        String
  nameFa        String
  icon          String?
  isActive      Boolean  @default(true)
  /// When true, hidden from free Survival / Duel pickers — only usable via RecordChallenge links.
  challengeOnly Boolean  @default(false)
  /// UI locales that may see this bank in pickers (e.g. ["fa"] for Iran-only topics).
  locales       String[] @default(["en", "fa"])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Primary-FK questions (`Question.categoryId`).
  questions          Question[]
  /// Extra bank memberships (M2N via QuestionCategory) — used by Draw.
  questionCategories QuestionCategory[]
  duelRounds         DuelRound[]
  matches            Match[]
  records            CategoryRecord[]
  challengeLinks     RecordChallengeCategory[]
}

// ─── RecordChallenge (Premium Live-Ops survival events) ──────────────────────
// Thematic campaigns (e.g. تاج آبی / Road to Euro). Hybrid economy:
// one-time unlockCostCoins + standard SURVIVAL_STAMINA_COST per run.

model RecordChallenge {
  id            String @id @default(cuid())
  slug          String @unique
  titleEn       String
  titleFa       String
  descriptionEn String @default("")
  descriptionFa String @default("")

  /// One-time coin sink to unlock the campaign for this event window.
  unlockCostCoins  Int
  /// Score required to conquer the challenge and earn the showcase badge.
  targetScore      Int
  /// Badge slug written to ClubBadge on conquer (prestige; not shop-purchasable).
  rewardBadgeSlug  String?
  rewardBadgeEmoji String? @default("🏆")

  /// Live-Ops theme week key (logo / stadium / career / formats). Null = plain RC.
  themeKey         String?
  /// Preferred QuestionType list for Survival draws inside this challenge, e.g. ["IMAGE","REVEAL_IMAGE"].
  preferredTypes   Json?
  /// Format bias density (1 = always prefer format, 5 = default ~1/5). Null = global default.
  formatBiasEveryN Int?

  isActive  Boolean   @default(true)
  startsAt  DateTime  @default(now())
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Assigned banks — empty = any public (non-challengeOnly) eligible category.
  categories RecordChallengeCategory[]
  access     ClubChallengeAccess[]
  runs       ClubChallengeRun[]
  matches    Match[]
  badges     ClubBadge[]

  @@index([isActive, expiresAt])
}

/// Many-to-many: which category banks a premium challenge may use.
model RecordChallengeCategory {
  id          String          @id @default(cuid())
  challengeId String
  challenge   RecordChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  categoryId  String
  category    Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([challengeId, categoryId])
  @@index([categoryId])
}

/// Paid unlock ledger — club paid unlockCostCoins once (per challenge).
model ClubChallengeAccess {
  id          String          @id @default(cuid())
  clubId      String
  club        Club            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  challengeId String
  challenge   RecordChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  coinsSpent Int
  unlockedAt DateTime @default(now())

  @@unique([clubId, challengeId])
  @@index([challengeId])
  @@index([clubId])
}

/// Best attempt + conquer state for a club on a premium challenge.
model ClubChallengeRun {
  id          String          @id @default(cuid())
  clubId      String
  club        Club            @relation(fields: [clubId], references: [id], onDelete: Cascade)
  challengeId String
  challenge   RecordChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  bestScore    Int       @default(0)
  attempts     Int       @default(0)
  conqueredAt  DateTime?
  badgeGranted Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clubId, challengeId])
  @@index([challengeId, bestScore])
  @@index([clubId])
}

/// Per-club, per-category Survival high-score ledger.
model CategoryRecord {
  id               String   @id @default(cuid())
  clubId           String
  club             Club     @relation(fields: [clubId], references: [id], onDelete: Cascade)
  categoryId       String
  category         Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  /// Best correct-answer streak/score in Survival for this category.
  maxSurvivalScore Int      @default(0)
  matchesPlayed    Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([clubId, categoryId])
  @@index([categoryId, maxSurvivalScore])
  @@index([clubId])
}

// ─── Tag (free-form labels) ──────────────────────────────────────────────────
// Many-to-many with Question (implicit join table). E.g. "nostalgia", "derby".

model Tag {
  id     String @id @default(cuid())
  slug   String @unique
  nameEn String
  nameFa String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  questions Question[]
}

// ─── Question (trivia dictionary) ────────────────────────────────────────────
// Server-authoritative answer source; never client-editable. Localized text +
// options live in `content` JSON: { en: {text, options, category}, fa: {…} }.

model Question {
  id           String             @id @default(cuid())
  type         QuestionType       @default(TEXT)
  /// Media asset for IMAGE / REVEAL_IMAGE (and similar) prompts. Null for TEXT.
  mediaUrl     String?
  /// Localized presentation: { en: { text, options[], category }, fa: {…} }.
  content      Json
  correctIndex Int
  difficulty   QuestionDifficulty @default(EASY)

  /// Primary category (Admin UI / default home bank). Keep stable for forms.
  categoryId String?
  category   Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  /// Additional category memberships for Draw (M2N). Does not replace `categoryId`.
  categories QuestionCategory[]
  tags       Tag[]

  /// Optional flavor for match framing ("penalty", "derby", …)
  matchContext String?

  // Publishing lifecycle (replaces the old isActive boolean). Only PUBLISHED
  // questions are served to players; DRAFT/IN_REVIEW gate AI/crowd content.
  status QuestionStatus @default(PUBLISHED)

  // Adaptive difficulty (measured). `difficulty` stays as the authored bucket
  // for admin filtering; `eloRating` is the live signal updated from real play.
  eloRating    Float @default(1500)
  timesServed  Int   @default(0)
  timesCorrect Int   @default(0)

  /// Optional bilingual trivia fact shown after reveal: `{ en: string, fa: string }`.
  explanation Json?

  // Content lifecycle metadata
  /// True when the fact expires over time ("current Real Madrid coach") and
  /// needs periodic review. Pair with `asOfDate`.
  isTemporal  Boolean   @default(false)
  /// The date the answer is valid as-of (for temporal questions).
  asOfDate    DateTime?
  /// Provenance: author name or the AI model that generated it.
  source      String?
  /// Normalized fingerprint of the content for exact-duplicate detection.
  contentHash String?   @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reports QuestionReport[]

  @@index([categoryId, difficulty])
  @@index([status])
  @@index([eloRating])
}

// ─── QuestionCategory (M2N bank membership) ──────────────────────────────────
// A question may appear in multiple Category draws without duplicating the row.
// `Question.categoryId` remains the primary/home category for Admin UX.
// Tags stay for Live-Ops / campaigns — not game-rule banks.

model QuestionCategory {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([questionId, categoryId])
  @@index([categoryId])
  @@index([questionId])
}

// ─── QuestionReport (user-submitted content flags) ───────────────────────────
// Feeds the admin triage queue (wrong answer, broken image, typo, …).

model QuestionReport {
  id         String       @id @default(cuid())
  questionId String
  question   Question     @relation(fields: [questionId], references: [id], onDelete: Cascade)
  /// User id who filed the report (nullable until auth exists).
  reporterId String?
  reason     String
  note       String?
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now())

  @@index([status])
  @@index([questionId])
}

// ─── DuelMatch (async Draft Duel) ────────────────────────────────────────────
// Turn-based 1v1. Challenger = player A. Opponent may be a human or a bot
// (isBotOpponent). Scoring is correct-answer totals across attack + defense.

model DuelMatch {
  id String @id @default(cuid())

  challengerId    String
  challenger      User    @relation("DuelChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  /// Null while MATCHING; set when a human/bot is assigned.
  opponentId      String?
  opponent        User?   @relation("DuelOpponent", fields: [opponentId], references: [id], onDelete: SetNull)
  isBotOpponent   Boolean @default(false)
  /// Human timed out; remaining turns are fabricated (Shadow Bot). Keep names.
  shadowBotActive Boolean @default(false)
  /// User id who went AFK (sees "lost due to timeout"; never told a bot played).
  timeoutUserId   String?

  status DuelStatus @default(MATCHING)

  /// Whose turn it is right now (null when terminal).
  turnUserId     String?
  /// Soft deadline for the current turn (cron → walkover / shadow bot).
  turnDeadlineAt DateTime?
  /// When a bot is scheduled to auto-play its next action (simulated delay).
  botPlayAt      DateTime?

  challengerCorrect Int     @default(0)
  opponentCorrect   Int     @default(0)
  winnerId          String?

  /// Stamina already spent when the duel was opened (anti double-charge).
  staminaSpent    Int     @default(0)
  /// Weekly leaderboard points already granted on COMPLETED.
  weeklyXpAwarded Boolean @default(false)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  finishedAt DateTime?

  rounds DuelRound[]

  @@index([challengerId, status])
  @@index([opponentId, status])
  @@index([status, turnDeadlineAt])
  @@index([status, botPlayAt])
}

// ─── DuelRound (one attack half + its defense) ───────────────────────────────
// Round 1: challenger attacks. Round 2: opponent attacks.
// `questionIds` are locked server-side after the attacker submits.

model DuelRound {
  id     String    @id @default(cuid())
  duelId String
  duel   DuelMatch @relation(fields: [duelId], references: [id], onDelete: Cascade)

  /// 1 = challenger attack, 2 = opponent attack (v1: exactly two rounds).
  roundNumber Int
  attackerId  String

  /// QUIZ = draft + MCQ; specials freeze payload in boardJson for both halves.
  roundType DuelRoundType @default(QUIZ)

  /// The 3 category ids offered in the draft UI (empty [] for specials).
  draftOptionIds Json
  categoryId     String?
  category       Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  /// Locked question ids for QUIZ attack (length = GameConfig.duel.questionsPerAttack).
  questionIds Json?

  /// Special round payload (MEMORY board / MYSTERY target / GRID axes / STAR_PATH path).
  boardJson Json?

  /// Answer logs:
  /// QUIZ: [{ questionId, selectedIndex, correct, ms }]
  /// Specials: format-specific JSON — see lib/duel/*Types.ts
  attackAnswers  Json?
  defenseAnswers Json?
  attackCorrect  Int   @default(0)
  defenseCorrect Int   @default(0)

  /// When the actor opened the half (timed specials; QUIZ unused).
  attackStartedAt  DateTime?
  defenseStartedAt DateTime?

  attackSubmittedAt  DateTime?
  defenseSubmittedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([duelId, roundNumber])
  @@index([duelId])
  @@index([attackerId])
  @@index([roundType])
}

// ─── LiveOps Missions (admin-managed batches of 3) ────────────────────────────
// MissionBatch = chest + schedule. Mission = one objective inside a batch.
// ClubMissionBatch / ClubMission track per-club progress & chest claims.

model MissionBatch {
  id         String           @id @default(cuid())
  /// Display / unlock order (1, 2, 3…). Unique so LiveOps never doubles a slot.
  batchIndex Int              @unique
  kind       MissionBatchKind @default(CAMPAIGN)
  /// Tehran calendar day key for DAILY batches (`YYYY-MM-DD`). Null for campaign.
  dayKey     String?          @unique
  chestCoins Int              @default(0)
  chestXp    Int              @default(0)
  isActive   Boolean          @default(true)
  startsAt   DateTime?
  endsAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  missions     Mission[]
  clubProgress ClubMissionBatch[]

  @@index([isActive, batchIndex])
  @@index([kind, dayKey])
}

model Mission {
  id      String       @id @default(cuid())
  batchId String
  batch   MissionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  titleFa       String
  titleEn       String
  objectiveType MissionObjective
  targetValue   Int
  /// Small drip when this single mission completes.
  rewardCoins   Int              @default(0)
  rewardXp      Int              @default(0)
  sortOrder     Int              @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clubProgress ClubMission[]

  @@index([batchId, sortOrder])
}

model ClubMissionBatch {
  id      String       @id @default(cuid())
  clubId  String
  batchId String
  club    Club         @relation(fields: [clubId], references: [id], onDelete: Cascade)
  batch   MissionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  /// Null until the player claims the batch chest (all 3 missions done).
  chestClaimedAt       DateTime?
  /// Idempotency: skip re-applying the same resolved match.
  lastProcessedMatchId String?
  unlockedAt           DateTime  @default(now())

  @@unique([clubId, batchId])
  @@index([clubId])
}

model ClubMission {
  id        String  @id @default(cuid())
  clubId    String
  missionId String
  club      Club    @relation(fields: [clubId], references: [id], onDelete: Cascade)
  mission   Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  progress        Int       @default(0)
  isCompleted     Boolean   @default(false)
  completedAt     DateTime?
  /// Manual drip claim: set when the player taps «Claim» (or auto for 0-reward).
  /// Completion alone does NOT pay coins/XP — that waits on this timestamp.
  rewardClaimedAt DateTime?

  @@unique([clubId, missionId])
  @@index([clubId])
}

// ─── FootballPlayer catalog (Mysterious Player + future formats) ─────────────
/// Stable slug PK so DailyMysteryPuzzle.targetPlayerId stays human-readable.
model FootballPlayer {
  /// Stable slug, e.g. "messi" — also used as Mystery guess id.
  slug String @id

  nameEn          String
  nameFa          String
  nationality     String
  nationalityCode String
  /// GK | DEF | MID | FWD
  position        String
  league          String
  club            String
  age             Int
  shirtNumber     Int

  /// Career clubs (names or stable IDs) for Immortal-style Grid intersections.
  pastClubs Json @default("[]")
  /// Major trophies / achievements, e.g. ["World Cup", "UCL"].
  trophies  Json @default("[]")

  /// Inactive players are hidden from guess pickers and auto-picks.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  puzzles         DailyMysteryPuzzle[]
  starPathPuzzles DailyStarPathPuzzle[]

  @@index([isActive])
  @@index([nameEn])
  @@index([club])
}

// ─── Daily Mystery (بازیکن مرموز) ────────────────────────────────────────────
// Isolated ledger — does NOT write Match rows. See ADR 001.

/// One puzzle published per Tehran calendar day (`dateKey` = YYYY-MM-DD).
model DailyMysteryPuzzle {
  id String @id @default(cuid())

  /// Tehran calendar day key, e.g. "2026-07-28". Unique — one puzzle per day.
  dateKey String @unique

  /// FK → FootballPlayer.slug
  targetPlayerId String
  targetPlayer   FootballPlayer @relation(fields: [targetPlayerId], references: [slug], onDelete: Restrict)

  /// Optional Live-Ops knobs: maxGuesses, hint set, difficulty band, etc.
  config Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempts DailyMysteryAttempt[]

  @@index([targetPlayerId])
}

/// One attempt per club per puzzle (enforced by @@unique).
model DailyMysteryAttempt {
  id String @id @default(cuid())

  clubId String
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  puzzleId String
  puzzle   DailyMysteryPuzzle @relation(fields: [puzzleId], references: [id], onDelete: Cascade)

  status     DailyMysteryAttemptStatus @default(IN_PROGRESS)
  guessCount Int                       @default(0)

  /// Sequential guesses, e.g. [{ playerId, isCorrectNationality, isCorrectLeague, … }].
  guesses Json @default("[]")

  /// Shareable emoji grid (🟩🟨🟥…).
  shareCode String?

  /// Lightweight GotD payout audit: { coinsEarned, xpEarned, streakBonus, … }.
  rewardJson Json?

  solvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clubId, puzzleId])
  @@index([clubId, status])
  @@index([puzzleId])
  @@index([solvedAt])
}

// ─── Daily Football Grid (3×3 Immortal-style) — ADR 002 ───────────────────────
// Isolated ledger — does NOT write Match rows.

/// One 3×3 grid published per Tehran calendar day.
model DailyGridPuzzle {
  id String @id @default(cuid())

  /// Tehran calendar day key, e.g. "2026-07-29". Unique — one grid per day.
  dateKey String @unique

  /// Three row axes: [{ id, labelEn, labelFa, rule }].
  rowsJson Json
  /// Three column axes: same shape as rowsJson.
  colsJson Json

  /// Optional Live-Ops knobs: maxMistakes (default 9).
  config Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempts DailyGridAttempt[]
}

/// One attempt per club per grid puzzle.
model DailyGridAttempt {
  id String @id @default(cuid())

  clubId String
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  puzzleId String
  puzzle   DailyGridPuzzle @relation(fields: [puzzleId], references: [id], onDelete: Cascade)

  status DailyGridAttemptStatus @default(IN_PROGRESS)

  /// Wrong guesses that did not fill a cell.
  mistakeCount Int @default(0)

  /// Filled cells: { "r,c": { playerId, nameEn, nameFa } }.
  cellsJson Json @default("{}")

  /// Wrong guess log (optional analytics): [{ playerId, row, col, at }].
  guessesJson Json @default("[]")

  shareCode String?
  solvedAt  DateTime?

  /// Lightweight GotD payout audit: { coinsEarned, xpEarned, streakBonus, … }.
  rewardJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clubId, puzzleId])
  @@index([clubId, status])
  @@index([puzzleId])
  @@index([solvedAt])
}

// ─── Daily Star Path (مسیر ستاره) — GotD #3 ──────────────────────────────────
// Isolated ledger — does NOT write Match rows. Clues from FootballPlayer.pastClubs.

/// One Star Path puzzle published per Tehran calendar day.
model DailyStarPathPuzzle {
  id String @id @default(cuid())

  /// Tehran calendar day key, e.g. "2026-07-31". Unique — one puzzle per day.
  dateKey String @unique

  /// FK → FootballPlayer.slug (target to guess).
  targetPlayerId String
  targetPlayer   FootballPlayer @relation(fields: [targetPlayerId], references: [slug], onDelete: Restrict)

  /// Snapshot of club steps for the day: [{ "name": "Sporting CP" }, …].
  /// Frozen at puzzle create so catalog edits don't change mid-day.
  pathJson Json

  /// Optional Live-Ops knobs: maxClues (default 4).
  config Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempts DailyStarPathAttempt[]

  @@index([targetPlayerId])
}

/// One attempt per club per Star Path puzzle.
model DailyStarPathAttempt {
  id String @id @default(cuid())

  clubId String
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  puzzleId String
  puzzle   DailyStarPathPuzzle @relation(fields: [puzzleId], references: [id], onDelete: Cascade)

  status DailyStarPathAttemptStatus @default(IN_PROGRESS)

  /// How many club clues are visible (1..maxClues). Starts at 1.
  cluesRevealed Int @default(1)

  /// Score when SOLVED: 100 | 75 | 50 | 25. FAILED → 0.
  score Int @default(0)

  /// Guess log: [{ playerId, correct, at }].
  guessesJson Json @default("[]")

  shareCode String?
  solvedAt  DateTime?

  /// Lightweight GotD payout audit: { coinsEarned, xpEarned, score, … }.
  rewardJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clubId, puzzleId])
  @@index([clubId, status])
  @@index([puzzleId])
  @@index([solvedAt])
}

// ─── Memory Game of the Day ──────────────────────────────────────────────────

model DailyMemoryPuzzle {
  id      String @id @default(cuid())
  dateKey String @unique

  /// Board seed — same string fed into buildMemoryBoard for the day.
  seed String

  /// Pair count (2–8). Frozen so Live-Ops retunes don't change mid-day boards.
  pairCount Int @default(8)

  /// Optional Live-Ops knobs (turnMs override, etc.).
  config Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempts DailyMemoryAttempt[]

  @@index([dateKey])
}

model DailyMemoryAttempt {
  id String @id @default(cuid())

  clubId String
  club   Club   @relation(fields: [clubId], references: [id], onDelete: Cascade)

  puzzleId String
  puzzle   DailyMemoryPuzzle @relation(fields: [puzzleId], references: [id], onDelete: Cascade)

  status DailyMemoryAttemptStatus @default(IN_PROGRESS)

  pairsFound Int @default(0)
  /// MemoryAttemptLog JSON when finished.
  logJson    Json?

  shareCode  String?
  solvedAt   DateTime?
  rewardJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clubId, puzzleId])
  @@index([clubId, status])
  @@index([puzzleId])
  @@index([solvedAt])
}
